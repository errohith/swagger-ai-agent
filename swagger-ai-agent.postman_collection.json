							"mode": "raw",
							"raw": "{\n  \"specId\": \"{{SPEC_ID}}\",\n  \"selection\": {\n    \"mode\": \"operation\",\n    \"operationIds\": [\"getUsers\"]\n  },\n  \"options\": {\n    \"includeHappyPath\": true,\n    \"includeNegativeTests\": true\n  }\n}"
