						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"specId\": \"{{SPEC_ID}}\",\n  \"envName\": \"dev\",\n  \"operations\": [\"getUsers\", \"createUser\"],\n  \"testTypes\": [\"happy\", \"negative\"],\n  \"options\": {\n    \"timeout\": 30000,\n    \"retryCount\": 2,\n    \"stopOnFailure\": false\n  }\n}"
						},
						"url": {
							"raw": "http://localhost:{{PORT}}/api/execution/run",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "{{PORT}}",
							"path": [
								"api",
								"execution",
								"run"
							]
						},
						"description": "Execute a test run plan"
					},
					"response": []
				},
				{
					"name": "Get Run Status",
					"request": {
						"method": "GET",
						"header": [],
