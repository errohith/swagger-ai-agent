							"raw": "http://localhost:{{PORT}}/api/execution/status/:runId",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "{{PORT}}",
							"path": [
								"api",
								"execution",
								"status",
								":runId"
							],
							"variable": [
								{
									"key": "runId",
									"value": "{{RUN_ID}}",
									"description": "Run ID from execution response"
								}
							]
						},
						"description": "Get execution status and results"
					},
					"response": []
				},
				{
					"name": "Retry Failed Tests",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"runId\": \"{{RUN_ID}}\",\n  \"options\": {\n    \"timeout\": 45000,\n    \"retryCount\": 3\n  }\n}"
						},
						"url": {
							"raw": "http://localhost:{{PORT}}/api/execution/retry-failed",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "{{PORT}}",
							"path": [
								"api",
								"execution",
								"retry-failed"
							]
						},
						"description": "Retry only failed tests from a previous run"
					},
					"response": []
				}
			],
			"description": "Test execution and management"
		},
